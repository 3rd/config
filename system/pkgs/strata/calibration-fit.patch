+
+class FitProcess:
+    def __init__(self):
+        self.stdin = io.StringIO()
+        self.stdout = io.StringIO()
+        self.isRunning = True
+
+    def wait(self, timeout=None):
+        self.isRunning = False
+        return 0
+
+    def kill(self):
+        self.isRunning = False
+
+
+class FitEngine(FakeEngine):
+    def __init__(self, args, free=2048, error=None):
+        super().__init__(args, lambda f, p, w: 50.0, info_workers=1)
+        self.proc = FitProcess()
+        self.log = io.StringIO()
+        self.info["vram_elastic"] = 1
+        self.free = free
+        self.error = error
+        self.generations = 0
+        self.promptLengths = []
+
+    def generate(self, ids, max_new, sampling, cancel):
+        if self.error:
+            raise self.error
+
+        self.generations += 1
+        self.promptLengths.append(len(ids))
+        yield from super().generate(ids, max_new, sampling, cancel)
+
+    def vram(self, reserve):
+        if reserve != 0:
+            raise AssertionError("the telemetry probe must not resize the cache")
+        return {"vram_free_mib": self.free}
+
+    def close(self):
+        self.proc.wait()
+        self.proc.stdin.close()
+        self.proc.stdout.close()
+        self.log.close()
+
+
