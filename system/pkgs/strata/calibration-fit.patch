+FIT_BASE = ["--native", "model.gguf", "--pack", "p", "--expert-cache", "auto", "--prefill", "auto",
+            "--mtp", "mtp", "--spec", "4", "--spec-min-p", "0.5", "--max-context", "65536",
+            "--kv", "int8", "--kv-resident", "32768", "--vram-reserve-mib", "2048"]
