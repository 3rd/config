+    baseline, settings = fit.get("baseline"), fit.get("settings")
+    if not isinstance(baseline, dict) or set(baseline) != set((*FIT_INPUTS, "--vram-elastic")):
+        return False
+    if not all(value is None or isinstance(value, str) for flag, value in baseline.items() if flag != "--vram-elastic"):
+        return False
+    if not isinstance(baseline["--vram-elastic"], bool) or not isinstance(settings, dict):
+        return False
+    if set(settings) != set((*FIT_VALUES, "--vram-elastic")) or settings["--vram-elastic"] is not True:
+        return False
+    if not all(value is None or isinstance(value, str) for flag, value in settings.items() if flag != "--vram-elastic"):
+        return False
+    if any(value is not None and (not value.isascii() or not value.isdigit())
