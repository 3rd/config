+import ExternalAPI from '@server/api/externalapi';
+import type { IMDBRating } from '@server/api/rating/imdbRadarrProxy';
+import cacheManager from '@server/lib/cache';
+import { getAppVersion } from '@server/utils/appVersion';
+
+class IMDBSonarrProxy extends ExternalAPI {
+  constructor() {
+    super(
+      'https://skyhook.sonarr.tv/v1/tvdb',
+      {},
+      {
+        headers: { 'User-Agent': `Seerr/${getAppVersion()}` },
+        nodeCache: cacheManager.getCache('sonarr').data,
+        timeout: 10000,
+      }
+    );
+  }
+
+  public async getSeriesRatings(tvdbId: number, imdbId: string) {
+    const data = await this.get<unknown>(
+      `/shows/en/${tvdbId}`,
+      undefined,
+      43200
+    );
+    if (
+      typeof data !== 'object' ||
+      data === null ||
+      !('tvdbId' in data) ||
+      data.tvdbId !== tvdbId ||
+      !('imdbId' in data) ||
+      data.imdbId !== imdbId ||
+      !('title' in data) ||
+      typeof data.title !== 'string' ||
+      !('rating' in data)
+    ) {
+      return null;
+    }
+    const rating = data.rating;
+    if (
+      typeof rating !== 'object' ||
+      rating === null ||
+      !('value' in rating) ||
+      (typeof rating.value !== 'number' && typeof rating.value !== 'string') ||
+      !('count' in rating) ||
+      typeof rating.count !== 'number' ||
+      !Number.isInteger(rating.count) ||
+      rating.count <= 0
+    ) {
+      return null;
+    }
+    const score = Number(rating.value);
+    const isScoreValid = Number.isFinite(score) && score > 0 && score <= 10;
+    if (!isScoreValid) {
+      return null;
+    }
+
+    const ratings = {
+      title: data.title,
+      url: `https://www.imdb.com/title/${imdbId}`,
+      criticsScore: score,
+      criticsScoreCount: rating.count,
+    } satisfies IMDBRating;
+
+    return ratings;
+  }
+}
+
+export default IMDBSonarrProxy;
