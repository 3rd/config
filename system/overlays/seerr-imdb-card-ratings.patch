diff --git a/src/components/Common/ImdbRating/index.tsx b/src/components/Common/ImdbRating/index.tsx
new file mode 100644
--- /dev/null
+++ b/src/components/Common/ImdbRating/index.tsx
@@ -0,0 +1,137 @@
+import ImdbLogo from '@app/assets/services/imdb.svg';
+import Tooltip from '@app/components/Common/Tooltip';
+import defineMessages from '@app/utils/defineMessages';
+import axios from 'axios';
+import { useIntl } from 'react-intl';
+
+const messages = defineMessages('components.Common.ImdbRating', {
+  imdbFailed: 'Could not fetch IMDb rating',
+  imdbLoading: 'Fetching IMDb rating',
+  imdbRating: 'IMDb rating: {score}/10',
+  imdbUnavailable: 'IMDb rating unavailable',
+  imdbVotes: 'IMDb rating: {score}/10 – votes: {formattedCount}',
+});
+
+interface ImdbRatingProps {
+  ratings: unknown;
+  error: unknown;
+  isLoading: boolean;
+  variant: 'card' | 'detail';
+  imdbId?: string;
+}
+
+const readImdbRating = (ratings: unknown) => {
+  if (typeof ratings !== 'object' || ratings === null || !('imdb' in ratings)) {
+    return;
+  }
+
+  const imdb = ratings.imdb;
+  if (typeof imdb !== 'object' || imdb === null || !('criticsScore' in imdb)) {
+    return;
+  }
+
+  const score = imdb.criticsScore;
+  if (
+    typeof score !== 'number' ||
+    !Number.isFinite(score) ||
+    score <= 0 ||
+    score > 10
+  ) {
+    return;
+  }
+
+  let voteCount;
+
+  if (
+    'criticsScoreCount' in imdb &&
+    typeof imdb.criticsScoreCount === 'number' &&
+    Number.isInteger(imdb.criticsScoreCount) &&
+    imdb.criticsScoreCount > 0
+  ) {
+    voteCount = imdb.criticsScoreCount;
+  }
+
+  return { score, voteCount };
+};
+
+const ImdbRating = ({
+  ratings,
+  error,
+  isLoading,
+  variant,
+  imdbId,
+}: ImdbRatingProps) => {
+  const intl = useIntl();
+  const rating = readImdbRating(ratings);
+  const isRatingUnavailable =
+    axios.isAxiosError(error) && error.response?.status === 404;
+  let label = intl.formatMessage(messages.imdbUnavailable);
+
+  if (rating !== undefined) {
+    if (variant === 'detail' && rating.voteCount !== undefined) {
+      label = intl.formatMessage(messages.imdbVotes, {
+        score: rating.score,
+        formattedCount: intl.formatNumber(rating.voteCount, {
+          notation: 'compact',
+          compactDisplay: 'short',
+          maximumFractionDigits: 1,
+        }),
+      });
+    } else {
+      label = intl.formatMessage(messages.imdbRating, { score: rating.score });
+    }
+  } else if (isLoading) {
+    label = intl.formatMessage(messages.imdbLoading);
+  } else if (error !== undefined && !isRatingUnavailable) {
+    label = intl.formatMessage(messages.imdbFailed);
+  }
+
+  const content = (
+    <>
+      <ImdbLogo
+        className={variant === 'card' ? 'h-3 w-6' : 'mr-1 w-6'}
+        aria-hidden="true"
+      />
+      <span>{rating === undefined ? '?' : rating.score.toFixed(1)}</span>
+    </>
+  );
+
+  if (variant === 'card') {
+    return (
+      <span
+        className="flex items-center gap-1 text-sm font-medium"
+        aria-label={label}
+        title={label}
+      >
+        {content}
+      </span>
+    );
+  }
+
+  const hasImdbLink = typeof imdbId === 'string' && /^tt\d+$/.test(imdbId);
+  if (hasImdbLink) {
+    return (
+      <Tooltip content={label}>
+        <a
+          href={`https://www.imdb.com/title/${imdbId}`}
+          className="media-rating"
+          aria-label={label}
+          target="_blank"
+          rel="noreferrer"
+        >
+          {content}
+        </a>
+      </Tooltip>
+    );
+  }
+
+  return (
+    <Tooltip content={label}>
+      <span className="media-rating" aria-label={label}>
+        {content}
+      </span>
+    </Tooltip>
+  );
+};
+
+export default ImdbRating;
diff --git a/src/hooks/useImdbRating.ts b/src/hooks/useImdbRating.ts
new file mode 100644
--- /dev/null
+++ b/src/hooks/useImdbRating.ts
@@ -0,0 +1,18 @@
+import type { MediaType } from '@server/models/Search';
+import useSWR from 'swr';
+
+const useImdbRating = (mediaType: MediaType, id?: number) => {
+  const canShowImdbRating = mediaType === 'movie' || mediaType === 'tv';
+  const ratingsPath =
+    canShowImdbRating && id !== undefined
+      ? `/api/v1/${mediaType}/${id}/ratings/imdb`
+      : null;
+  const { data, error, isLoading } = useSWR<unknown, unknown>(ratingsPath, {
+    revalidateOnFocus: false,
+    shouldRetryOnError: false,
+  });
+
+  return { data, error, isLoading, canShowImdbRating };
+};
+
+export default useImdbRating;
