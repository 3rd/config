diff --git a/server/routes/discover-imdb.test.ts b/server/routes/discover-imdb.test.ts
new file mode 100644
--- /dev/null
+++ b/server/routes/discover-imdb.test.ts
@@ -0,0 +1,422 @@
+import IMDBSonarrProxy from '@server/api/rating/imdb-sonarr-proxy';
+import IMDBRadarrProxy, {
+  type IMDBRating,
+} from '@server/api/rating/imdbRadarrProxy';
+import type {
+  TmdbMovieDetails,
+  TmdbMovieResult,
+  TmdbTvDetails,
+  TmdbTvResult,
+} from '@server/api/themoviedb/interfaces';
+import Media from '@server/entity/Media';
+import cacheManager from '@server/lib/cache';
+import imdbRatingCache, {
+  ImdbRatingCache,
+} from '@server/lib/imdb-rating-cache';
+import axios, { type InternalAxiosRequestConfig } from 'axios';
+import express from 'express';
+import * as OpenApiValidator from 'express-openapi-validator';
+import assert from 'node:assert/strict';
+import { mkdtemp, rm } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, beforeEach, it, mock } from 'node:test';
+import request from 'supertest';
+import discoverRoutes from './discover';
+import settingsRoutes from './settings';
+
+const buildMovie = (id: number) =>
+  ({
+    id,
+    media_type: 'movie',
+    title: `Movie ${id}`,
+    original_title: `Movie ${id}`,
+    release_date: '2020-01-01',
+    adult: false,
+    video: false,
+    popularity: 10,
+    vote_count: 100,
+    vote_average: 4,
+    genre_ids: [],
+    overview: '',
+    original_language: 'en',
+  }) satisfies TmdbMovieResult;
+
+const buildMovieDetails = (id: number) =>
+  ({
+    ...buildMovie(id),
+    imdb_id: `tt${id}`,
+    budget: 0,
+    genres: [],
+    production_companies: [],
+    production_countries: [],
+    release_dates: { results: [] },
+    revenue: 0,
+    spoken_languages: [],
+    status: 'Released',
+    credits: { cast: [], crew: [] },
+    external_ids: { imdb_id: `tt${id}` },
+    videos: { results: [] },
+    keywords: { keywords: [] },
+  }) satisfies TmdbMovieDetails;
+
+const buildSeries = (id: number) =>
+  ({
+    id,
+    media_type: 'tv',
+    name: `Series ${id}`,
+    original_name: `Series ${id}`,
+    first_air_date: '2020-01-01',
+    origin_country: [],
+    popularity: 10,
+    vote_count: 100,
+    vote_average: 4,
+    genre_ids: [],
+    overview: '',
+    original_language: 'en',
+  }) satisfies TmdbTvResult;
+
+const buildSeriesDetails = (id: number) =>
+  ({
+    ...buildSeries(id),
+    content_ratings: { results: [] },
+    created_by: [],
+    episode_run_time: [],
+    genres: [],
+    homepage: '',
+    in_production: false,
+    languages: ['en'],
+    last_air_date: '2020-01-01',
+    networks: [],
+    number_of_episodes: 1,
+    number_of_seasons: 1,
+    production_companies: [],
+    production_countries: [],
+    spoken_languages: [],
+    seasons: [],
+    status: 'Ended',
+    type: 'Scripted',
+    aggregate_credits: { cast: [] },
+    credits: { crew: [] },
+    external_ids: { imdb_id: `tt${id}`, tvdb_id: id + 100 },
+    keywords: { results: [] },
+    videos: { results: [] },
+  }) satisfies TmdbTvDetails;
+
+const buildRating = (score: number) =>
+  ({
+    title: 'Rated title',
+    url: 'https://www.imdb.com/title/tt1',
+    criticsScore: score,
+    criticsScoreCount: 100,
+  }) satisfies IMDBRating;
+
+const app = express();
+app.use(
+  OpenApiValidator.middleware({
+    apiSpec: path.resolve('seerr-api.yml'),
+    validateRequests: true,
+    validateSecurity: false,
+  })
+);
+app.use('/api/v1/discover', discoverRoutes);
+app.use('/api/v1/settings', settingsRoutes);
+app.use(
+  (
+    error: { status?: number; message: string },
+    _req: express.Request,
+    res: express.Response,
+    next: express.NextFunction
+  ) => {
+    if (res.headersSent) return next(error);
+
+    res.status(error.status ?? 500).json({ message: error.message });
+  }
+);
+
+const responses = new Map<string, unknown>();
+const requests: InternalAxiosRequestConfig[] = [];
+const originalAdapter = axios.defaults.adapter;
+let cacheDirectory: string;
+
+beforeEach(async () => {
+  cacheDirectory = await mkdtemp(
+    path.join(os.tmpdir(), 'seerr-imdb-route-test-')
+  );
+  const isolatedCache = new ImdbRatingCache(cacheDirectory);
+  mock.method(
+    imdbRatingCache,
+    'getOrFetch',
+    isolatedCache.getOrFetch.bind(isolatedCache)
+  );
+  mock.method(
+    imdbRatingCache,
+    'clear',
+    isolatedCache.clear.bind(isolatedCache)
+  );
+
+  responses.clear();
+  requests.length = 0;
+  cacheManager.getCache('tmdb').flush();
+  cacheManager.getCache('imdb').flush();
+  cacheManager.getCache('sonarr').flush();
+  mock.method(Media, 'getRelatedMedia', async () => []);
+  axios.defaults.adapter = async (config) => {
+    requests.push(config);
+    const data = responses.get(config.url ?? '');
+    assert.notStrictEqual(data, undefined, `Unexpected request: ${config.url}`);
+
+    return { data, status: 200, statusText: 'OK', headers: {}, config };
+  };
+});
+
+afterEach(async () => {
+  axios.defaults.adapter = originalAdapter;
+  mock.restoreAll();
+  await rm(cacheDirectory, { recursive: true, force: true });
+});
+
+it('filters movie IMDb scores inclusively without changing TMDB order or filters', async () => {
+  responses.set('/discover/movie', {
+    page: 1,
+    total_pages: 10,
+    total_results: 200,
+    results: [1, 2, 3, 4, 5].map(buildMovie),
+  });
+
+  for (const id of [1, 2, 3, 4, 5]) {
+    responses.set(`/movie/${id}`, buildMovieDetails(id));
+  }
+
+  const ratings = new Map([
+    ['tt1', buildRating(8.5)],
+    ['tt2', buildRating(7.4)],
+    ['tt3', buildRating(7.5)],
+    ['tt4', buildRating(8.6)],
+  ]);
+  mock.method(
+    IMDBRadarrProxy.prototype,
+    'getMovieRatings',
+    async (id: string) => ratings.get(id) ?? null
+  );
+
+  const response = await request(app).get('/api/v1/discover/movies').query({
+    imdbRatingGte: 7.5,
+    imdbRatingLte: 8.5,
+    voteAverageGte: 4,
+    genre: '18',
+  });
+  assert.equal(response.status, 200);
+  assert.deepEqual(
+    response.body.results.map((result: { id: number }) => result.id),
+    [1, 3]
+  );
+  assert.equal(response.body.hasMore, true);
+  assert.equal(response.body.totalResults, 200);
+  assert.equal(requests[0].params['vote_average.gte'], '4');
+  assert.equal(requests[0].params.with_genres, '18');
+  assert.equal(requests[0].params.imdbRatingGte, undefined);
+});
+
+it('filters series through IMDb and excludes missing TVDB mappings', async () => {
+  responses.set('/discover/tv', {
+    page: 1,
+    total_pages: 1,
+    total_results: 3,
+    results: [1, 2, 3].map(buildSeries),
+  });
+  responses.set('/tv/1', buildSeriesDetails(1));
+  responses.set('/tv/2', buildSeriesDetails(2));
+  const missingMapping: TmdbTvDetails = buildSeriesDetails(3);
+  delete missingMapping.external_ids.tvdb_id;
+  responses.set('/tv/3', missingMapping);
+  mock.method(
+    IMDBSonarrProxy.prototype,
+    'getSeriesRatings',
+    async (tvdbId: number, imdbId: string) => {
+      assert.equal(imdbId, `tt${tvdbId - 100}`);
+
+      return buildRating(tvdbId === 101 ? 8 : 6);
+    }
+  );
+
+  const response = await request(app).get(
+    '/api/v1/discover/tv?imdbRatingGte=7.5'
+  );
+  assert.equal(response.status, 200);
+  assert.deepEqual(
+    response.body.results.map((result: { id: number }) => result.id),
+    [1]
+  );
+  assert.equal(response.body.hasMore, false);
+});
+
+it('keeps an empty filtered page open until the TMDB page limit', async () => {
+  responses.set('/discover/movie', {
+    page: 499,
+    total_pages: 700,
+    total_results: 14000,
+    results: [buildMovie(1)],
+  });
+  responses.set('/movie/1', buildMovieDetails(1));
+  mock.method(IMDBRadarrProxy.prototype, 'getMovieRatings', async () =>
+    buildRating(11)
+  );
+
+  const response = await request(app).get(
+    '/api/v1/discover/movies?page=499&imdbRatingLte=8'
+  );
+  assert.equal(response.status, 200);
+  assert.deepEqual(response.body.results, []);
+  assert.equal(response.body.hasMore, true);
+
+  responses.set('/discover/movie', {
+    page: 500,
+    total_pages: 700,
+    total_results: 14000,
+    results: [],
+  });
+  const lastResponse = await request(app).get(
+    '/api/v1/discover/movies?page=500&imdbRatingLte=8'
+  );
+  assert.equal(lastResponse.status, 200);
+  assert.equal(lastResponse.body.hasMore, false);
+});
+
+it('does not fetch IMDb ratings when the filter is absent', async () => {
+  responses.set('/discover/movie', {
+    page: 1,
+    total_pages: 1,
+    total_results: 1,
+    results: [buildMovie(1)],
+  });
+
+  const response = await request(app).get('/api/v1/discover/movies');
+  assert.equal(response.status, 200);
+  assert.equal(response.body.results.length, 1);
+  assert.equal(response.body.hasMore, undefined);
+  assert.equal(requests.length, 1);
+});
+
+it('rejects invalid IMDb bounds before requesting titles', async () => {
+  const invalidNumber = await request(app).get(
+    '/api/v1/discover/movies?imdbRatingGte=11'
+  );
+  assert.equal(invalidNumber.status, 400);
+
+  const reversedRange = await request(app).get(
+    '/api/v1/discover/tv?imdbRatingGte=8&imdbRatingLte=7'
+  );
+  assert.equal(reversedRange.status, 400);
+  assert.match(reversedRange.body.message, /Invalid IMDb rating range/);
+  assert.equal(requests.length, 0);
+});
+
+it('returns an error when a ratings provider fails instead of an empty match set', async () => {
+  responses.set('/discover/movie', {
+    page: 1,
+    total_pages: 1,
+    total_results: 1,
+    results: [buildMovie(1)],
+  });
+  responses.set('/movie/1', buildMovieDetails(1));
+  mock.method(IMDBRadarrProxy.prototype, 'getMovieRatings', async () => {
+    throw new Error('Ratings provider unavailable');
+  });
+
+  const response = await request(app).get(
+    '/api/v1/discover/movies?imdbRatingGte=7'
+  );
+  assert.equal(response.status, 500);
+  assert.equal(response.body.message, 'Unable to retrieve popular movies.');
+});
+
+const cachedMediaCases = [
+  {
+    name: 'movies',
+    discoveryPath: '/discover/movie',
+    detailsPath: '/movie/1',
+    result: buildMovie(1),
+    details: { ...buildMovieDetails(1), release_date: '2026-10-10' },
+    ratingPath: '/movie/imdb/tt1',
+    buildProviderResponse: (score: number) => [
+      {
+        ImdbId: 'tt1',
+        Title: 'Synthetic movie',
+        MovieRatings: { Imdb: { Value: score, Count: 100 } },
+      },
+    ],
+    primeProvider: () => new IMDBRadarrProxy().getMovieRatings('tt1'),
+  },
+  {
+    name: 'tv',
+    discoveryPath: '/discover/tv',
+    detailsPath: '/tv/1',
+    result: buildSeries(1),
+    details: { ...buildSeriesDetails(1), last_air_date: '2026-10-10' },
+    ratingPath: '/shows/en/101',
+    buildProviderResponse: (score: number) => ({
+      tvdbId: 101,
+      imdbId: 'tt1',
+      title: 'Synthetic series',
+      rating: { value: score, count: 100 },
+    }),
+    primeProvider: () => new IMDBSonarrProxy().getSeriesRatings(101, 'tt1'),
+  },
+];
+
+for (const media of cachedMediaCases) {
+  it(`refreshes ${media.name} scores after disk expiry and an administrator flush`, async () => {
+    let now = Date.UTC(2026, 9, 10);
+    mock.method(Date, 'now', () => now);
+    responses.set(media.discoveryPath, {
+      page: 1,
+      total_pages: 1,
+      total_results: 1,
+      results: [media.result],
+    });
+    responses.set(media.detailsPath, media.details);
+    responses.set(media.ratingPath, media.buildProviderResponse(8));
+    const url = `/api/v1/discover/${media.name}?imdbRatingGte=7`;
+    const first = await request(app).get(url);
+    assert.equal(first.status, 200);
+    assert.deepEqual(
+      first.body.results.map((result: { id: number }) => result.id),
+      [1]
+    );
+
+    responses.set(media.ratingPath, media.buildProviderResponse(6));
+    const warm = await request(app).get(url);
+    assert.equal(warm.status, 200);
+    assert.equal(warm.body.results.length, 1);
+    assert.equal(
+      requests.filter((entry) => entry.url === media.ratingPath).length,
+      1
+    );
+
+    now += 6 * 60 * 60 * 1000 - 1;
+    await media.primeProvider();
+    now += 1;
+    responses.set(media.ratingPath, media.buildProviderResponse(9));
+    const expired = await request(app).get(url);
+    assert.equal(expired.status, 200);
+    assert.equal(expired.body.results.length, 1);
+    const requestsBeforeFlush = requests.filter(
+      (entry) => entry.url === media.ratingPath
+    ).length;
+    assert.equal(requestsBeforeFlush, media.name === 'movies' ? 3 : 2);
+
+    responses.set(media.ratingPath, media.buildProviderResponse(5));
+    const flushed = await request(app).post(
+      '/api/v1/settings/cache/imdb/flush'
+    );
+    assert.equal(flushed.status, 204);
+    const refreshed = await request(app).get(url);
+    assert.equal(refreshed.status, 200);
+    assert.deepEqual(refreshed.body.results, []);
+    assert.equal(
+      requests.filter((entry) => entry.url === media.ratingPath).length,
+      requestsBeforeFlush + 1
+    );
+  });
+}
