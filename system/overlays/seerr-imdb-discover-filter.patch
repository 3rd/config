diff --git a/server/lib/imdb-rating-cache.ts b/server/lib/imdb-rating-cache.ts
new file mode 100644
--- /dev/null
+++ b/server/lib/imdb-rating-cache.ts
@@ -0,0 +1,188 @@
+import {
+  imdbRatingSchema,
+  type IMDBRating,
+} from '@server/api/rating/imdbRadarrProxy';
+import logger from '@server/logger';
+import { appDataPath } from '@server/utils/appDataVolume';
+import { randomUUID } from 'node:crypto';
+import { mkdir, readFile, rename, rm, writeFile } from 'node:fs/promises';
+import path from 'node:path';
+import { z } from 'zod';
+
+const HOUR = 60 * 60 * 1000;
+const DAY = 24 * HOUR;
+const MAX_CONCURRENT_LOOKUPS = 5;
+
+const cacheEntrySchema = z.object({
+  version: z.literal(1),
+  mediaType: z.enum(['movie', 'tv']),
+  tmdbId: z.number().int().positive(),
+  expiresAt: z.number().int().nonnegative(),
+  rating: imdbRatingSchema.nullable(),
+});
+
+type ImdbRatingLookup = {
+  rating: IMDBRating | null;
+  releaseDate?: string;
+  isContinuingSeries?: boolean;
+};
+
+type ImdbRatingRequest = {
+  mediaType: 'movie' | 'tv';
+  tmdbId: number;
+  fetchRating: () => Promise<ImdbRatingLookup>;
+};
+
+const getRatingLifetime = (
+  { rating, releaseDate, isContinuingSeries }: ImdbRatingLookup,
+  now: number
+) => {
+  const releasedAt = Date.parse(`${releaseDate}T00:00:00Z`);
+  const needsEarlyRefresh =
+    !rating || !Number.isFinite(releasedAt) || releasedAt > now;
+  if (needsEarlyRefresh) return HOUR;
+
+  const ageDays = Math.floor((now - releasedAt) / DAY);
+  if (ageDays <= 30) return 6 * HOUR;
+  if (ageDays <= 365 || isContinuingSeries) return DAY;
+
+  return 7 * DAY;
+};
+
+export class ImdbRatingCache {
+  private directory: string;
+  private pending = new Map<string, Promise<IMDBRating | null>>();
+  private activeLookups = 0;
+  private waitingLookups: (() => void)[] = [];
+  private clearing?: Promise<void>;
+
+  constructor(directory = path.join(appDataPath(), 'cache', 'imdb')) {
+    this.directory = directory;
+  }
+
+  public async getOrFetch(request: ImdbRatingRequest) {
+    if (this.clearing) {
+      await this.clearing;
+    }
+
+    const key = `${request.mediaType}-${request.tmdbId}`;
+    const pending = this.pending.get(key);
+    if (pending) return pending;
+
+    const lookup = this.loadRating(key, request);
+    this.pending.set(key, lookup);
+
+    try {
+      return await lookup;
+    } finally {
+      this.pending.delete(key);
+    }
+  }
+
+  public async clear() {
+    const clearing = this.clearing ?? this.clearStoredRatings();
+    this.clearing = clearing;
+
+    try {
+      await clearing;
+    } finally {
+      if (this.clearing === clearing) {
+        this.clearing = undefined;
+      }
+    }
+  }
+
+  private async clearStoredRatings() {
+    await Promise.allSettled(this.pending.values());
+    await rm(this.directory, { recursive: true, force: true });
+  }
+
+  private async loadRating(key: string, request: ImdbRatingRequest) {
+    const filePath = path.join(this.directory, `${key}.json`);
+    const cached = await this.readRating(filePath, request);
+    if (cached !== undefined) return cached;
+
+    const result = await this.fetchRating(request.fetchRating);
+    await this.storeRating(filePath, request, result);
+
+    return result.rating;
+  }
+
+  private async readRating(filePath: string, request: ImdbRatingRequest) {
+    try {
+      const input: unknown = JSON.parse(await readFile(filePath, 'utf8'));
+      const cached = cacheEntrySchema.parse(input);
+      const isFreshMatch =
+        cached.mediaType === request.mediaType &&
+        cached.tmdbId === request.tmdbId &&
+        cached.expiresAt > Date.now();
+      if (isFreshMatch) return cached.rating;
+    } catch (error) {
+      if (
+        !(error instanceof Error && 'code' in error && error.code === 'ENOENT')
+      ) {
+        logger.warn('Unable to read IMDb rating cache entry', {
+          label: 'IMDb Cache',
+          filePath,
+          errorMessage: error instanceof Error ? error.message : String(error),
+        });
+      }
+    }
+  }
+
+  private async storeRating(
+    filePath: string,
+    request: ImdbRatingRequest,
+    result: ImdbRatingLookup
+  ) {
+    const now = Date.now();
+
+    try {
+      const entry = cacheEntrySchema.parse({
+        version: 1,
+        mediaType: request.mediaType,
+        tmdbId: request.tmdbId,
+        expiresAt: now + getRatingLifetime(result, now),
+        rating: result.rating,
+      });
+      await mkdir(this.directory, { recursive: true });
+      const temporaryPath = `${filePath}.${randomUUID()}.tmp`;
+
+      try {
+        await writeFile(temporaryPath, JSON.stringify(entry), { flag: 'wx' });
+        await rename(temporaryPath, filePath);
+      } finally {
+        await rm(temporaryPath, { force: true });
+      }
+    } catch (error) {
+      logger.warn('Unable to persist IMDb rating cache entry', {
+        label: 'IMDb Cache',
+        filePath,
+        errorMessage: error instanceof Error ? error.message : String(error),
+      });
+    }
+  }
+
+  private async fetchRating(fetchRating: ImdbRatingRequest['fetchRating']) {
+    if (this.activeLookups >= MAX_CONCURRENT_LOOKUPS) {
+      await new Promise<void>((resolve) => this.waitingLookups.push(resolve));
+    } else {
+      this.activeLookups += 1;
+    }
+
+    try {
+      return await fetchRating();
+    } finally {
+      const next = this.waitingLookups.shift();
+      if (next) {
+        next();
+      } else {
+        this.activeLookups -= 1;
+      }
+    }
+  }
+}
+
+const imdbRatingCache = new ImdbRatingCache();
+
+export default imdbRatingCache;
diff --git a/server/lib/imdb-rating-cache.test.ts b/server/lib/imdb-rating-cache.test.ts
