diff --git a/server/api/ratings.ts b/server/api/ratings.ts
--- a/server/api/ratings.ts
+++ b/server/api/ratings.ts
@@ -1,7 +1,106 @@
-import { type IMDBRating } from '@server/api/rating/imdbRadarrProxy';
+import IMDBSonarrProxy from '@server/api/rating/imdb-sonarr-proxy';
+import IMDBRadarrProxy, {
+  type IMDBRating,
+} from '@server/api/rating/imdbRadarrProxy';
 import { type RTRating } from '@server/api/rating/rottentomatoes';
+import type TheMovieDb from '@server/api/themoviedb';
+import imdbRatingCache from '@server/lib/imdb-rating-cache';
 
 export interface RatingResponse {
   rt?: RTRating;
   imdb?: IMDBRating;
 }
+
+const fetchImdbRating = async (
+  tmdb: TheMovieDb,
+  mediaType: 'movie' | 'tv',
+  id: number
+) => {
+  if (mediaType === 'movie') {
+    const movie = await tmdb.getMovie({ movieId: id });
+    const imdbId = movie.imdb_id;
+    const hasRatingId = typeof imdbId === 'string' && /^tt\d+$/.test(imdbId);
+    if (!hasRatingId) return { rating: null };
+
+    return {
+      rating: await new IMDBRadarrProxy().getMovieRatings(imdbId, 'refresh'),
+      releaseDate: movie.release_date,
+    };
+  }
+
+  const tv = await tmdb.getTvShow({ tvId: id });
+  const { tvdb_id: tvdbId, imdb_id: imdbId } = tv.external_ids;
+  const hasRatingIds =
+    typeof tvdbId === 'number' &&
+    Number.isInteger(tvdbId) &&
+    tvdbId > 0 &&
+    typeof imdbId === 'string' &&
+    /^tt\d+$/.test(imdbId);
+  if (!hasRatingIds) return { rating: null };
+
+  return {
+    rating: await new IMDBSonarrProxy().getSeriesRatings(
+      tvdbId,
+      imdbId,
+      'refresh'
+    ),
+    releaseDate: tv.last_air_date || tv.first_air_date,
+    isContinuingSeries: tv.in_production,
+  };
+};
+
+export const getImdbRating = (
+  tmdb: TheMovieDb,
+  mediaType: 'movie' | 'tv',
+  id: number
+) =>
+  imdbRatingCache.getOrFetch({
+    mediaType,
+    tmdbId: id,
+    fetchRating: () => fetchImdbRating(tmdb, mediaType, id),
+  });
+
+type ImdbFilterOptions = {
+  tmdb: TheMovieDb;
+  mediaType: 'movie' | 'tv';
+  imdbRatingGte?: number;
+  imdbRatingLte?: number;
+};
+
+export const filterByImdbRating = async <T extends { id: number }>(
+  results: T[],
+  { tmdb, mediaType, imdbRatingGte, imdbRatingLte }: ImdbFilterOptions
+) => {
+  const hasImdbFilter =
+    imdbRatingGte !== undefined || imdbRatingLte !== undefined;
+  if (!hasImdbFilter) return results;
+
+  const matches: T[] = [];
+
+  for (let offset = 0; offset < results.length; offset += 5) {
+    const batch = results.slice(offset, offset + 5);
+    const ratings = await Promise.all(
+      batch.map((result) => getImdbRating(tmdb, mediaType, result.id))
+    );
+
+    batch.forEach((result, index) => {
+      const score = ratings[index]?.criticsScore;
+      if (
+        typeof score !== 'number' ||
+        !Number.isFinite(score) ||
+        score <= 0 ||
+        score > 10
+      ) {
+        return;
+      }
+
+      const isWithinRange =
+        score >= (imdbRatingGte ?? 0) && score <= (imdbRatingLte ?? 10);
+      if (isWithinRange) {
+        matches.push(result);
+      }
+    });
+  }
+
+  return matches;
+};
