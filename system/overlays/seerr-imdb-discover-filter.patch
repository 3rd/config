+import type { IMDBRating } from '@server/api/rating/imdbRadarrProxy';
+import logger from '@server/logger';
+import assert from 'node:assert/strict';
+import { mkdtemp, rm, writeFile } from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { afterEach, beforeEach, it, mock } from 'node:test';
+import { ImdbRatingCache } from './imdb-rating-cache';
+
+const HOUR = 60 * 60 * 1000;
+const DAY = 24 * HOUR;
+const NOW = Date.UTC(2026, 9, 10);
+const rating = {
+  title: 'A synthetic movie',
+  url: 'https://www.imdb.com/title/tt123',
+  criticsScore: 8,
+  criticsScoreCount: 100,
+} satisfies IMDBRating;
+let directory: string;
+
+beforeEach(async () => {
+  directory = await mkdtemp(path.join(os.tmpdir(), 'seerr-imdb-cache-test-'));
+});
+
+afterEach(async () => {
+  mock.restoreAll();
+  await rm(directory, { recursive: true, force: true });
+});
+
+it('reuses ratings after a restart and keeps movie and TV IDs separate', async () => {
+  const firstCache = new ImdbRatingCache(directory);
+  const fetchRating = async () => ({ rating, releaseDate: '2020-01-01' });
+  await firstCache.getOrFetch({ mediaType: 'movie', tmdbId: 1, fetchRating });
+
+  const restartedCache = new ImdbRatingCache(directory);
+  const cached = await restartedCache.getOrFetch({
+    mediaType: 'movie',
+    tmdbId: 1,
+    fetchRating: async () =>
+      assert.fail('Fresh disk entry must avoid upstream'),
+  });
+  assert.deepEqual(cached, rating);
+
+  const seriesRating = { ...rating, criticsScore: 6 };
+  const series = await restartedCache.getOrFetch({
+    mediaType: 'tv',
+    tmdbId: 1,
+    fetchRating: async () => ({
+      rating: seriesRating,
+      releaseDate: '2020-01-01',
+    }),
+  });
+  assert.deepEqual(series, seriesRating);
+});
+
+const freshnessCases = [
+  { name: 'released 30 days ago', ageDays: 30, lifetime: 6 * HOUR },
+  { name: 'released 31 days ago', ageDays: 31, lifetime: DAY },
+  { name: 'released 365 days ago', ageDays: 365, lifetime: DAY },
+  { name: 'released 366 days ago', ageDays: 366, lifetime: 7 * DAY },
+  {
+    name: 'ongoing series',
+    ageDays: 1000,
+    isContinuingSeries: true,
+    lifetime: DAY,
+  },
+  { name: 'unknown release date', lifetime: HOUR },
+  { name: 'future release date', ageDays: -1, lifetime: HOUR },
+  { name: 'missing rating', ageDays: 1000, hasRating: false, lifetime: HOUR },
+];
+
+for (const testCase of freshnessCases) {
+  it(`refreshes ${testCase.name} at its expiry boundary`, async () => {
+    let now = NOW;
+    mock.method(Date, 'now', () => now);
+    const cache = new ImdbRatingCache(directory);
+    const lookup = {
+      rating: testCase.hasRating === false ? null : rating,
+      releaseDate:
+        testCase.ageDays === undefined
+          ? undefined
+          : new Date(NOW - testCase.ageDays * DAY).toISOString().slice(0, 10),
+      isContinuingSeries: testCase.isContinuingSeries,
+    };
+    const fetchRating = mock.fn(async () => lookup);
+    const request = { mediaType: 'movie', tmdbId: 1, fetchRating } as const;
+    assert.deepEqual(await cache.getOrFetch(request), lookup.rating);
+
+    now += testCase.lifetime - 1;
+    assert.deepEqual(await cache.getOrFetch(request), lookup.rating);
+    assert.equal(fetchRating.mock.callCount(), 1);
+
+    now += 1;
+    assert.deepEqual(await cache.getOrFetch(request), lookup.rating);
+    assert.equal(fetchRating.mock.callCount(), 2);
+  });
+}
+
+it('shares concurrent lookups and limits different titles to five upstream requests', async () => {
+  const cache = new ImdbRatingCache(directory);
+  const started = Promise.withResolvers<void>();
+  const release = Promise.withResolvers<void>();
+  let active = 0;
+  let peak = 0;
+  const fetchRating = mock.fn(async () => {
+    active += 1;
+    peak = Math.max(peak, active);
+    if (active === 5) {
+      started.resolve();
+    }
+
+    await release.promise;
+    active -= 1;
+
+    return { rating, releaseDate: '2020-01-01' };
+  });
+  const requests = Array.from(
+    { length: 10 },
+    (_, index) =>
+      ({
+        mediaType: 'movie',
+        tmdbId: index + 1,
+        fetchRating,
+      }) as const
+  );
+  const lookups = requests.flatMap((request) => [
+    cache.getOrFetch(request),
+    cache.getOrFetch(request),
+  ]);
+  await started.promise;
+  assert.equal(fetchRating.mock.callCount(), 5);
+
+  release.resolve();
+  const ratings = await Promise.all(lookups);
+  assert.deepEqual(
+    ratings,
+    Array.from({ length: 20 }, () => rating)
+  );
+  assert.equal(fetchRating.mock.callCount(), 10);
+  assert.equal(peak, 5);
+});
+
+it('preserves upstream errors without caching them or serving expired scores', async () => {
+  let now = NOW;
+  mock.method(Date, 'now', () => now);
+  const cache = new ImdbRatingCache(directory);
+  await cache.getOrFetch({
+    mediaType: 'movie',
+    tmdbId: 1,
+    fetchRating: async () => ({ rating, releaseDate: '2026-10-10' }),
+  });
+  now += 6 * HOUR;
+  const failure = new Error('Provider unavailable');
+  const fetchRating = mock.fn(async () => {
+    throw failure;
+  });
+  const request = { mediaType: 'movie', tmdbId: 1, fetchRating } as const;
+  await assert.rejects(cache.getOrFetch(request), (error) => error === failure);
+  await assert.rejects(cache.getOrFetch(request), (error) => error === failure);
+  assert.equal(fetchRating.mock.callCount(), 2);
+});
+
+it('replaces corrupt disk data with fresh ratings', async () => {
+  const warnings = mock.method(logger, 'warn', () => logger);
+  const filePath = path.join(directory, 'movie-1.json');
+  await writeFile(
+    filePath,
+    JSON.stringify({
+      version: 1,
+      mediaType: 'movie',
+      tmdbId: 1,
+      expiresAt: Date.now() + DAY,
+      rating: { ...rating, criticsScore: 11 },
+    })
+  );
+  const fetchRating = async () => ({ rating, releaseDate: '2020-01-01' });
+  const cache = new ImdbRatingCache(directory);
+  assert.deepEqual(
+    await cache.getOrFetch({ mediaType: 'movie', tmdbId: 1, fetchRating }),
+    rating
+  );
+  assert.equal(warnings.mock.callCount(), 1);
+});
+
+it('returns fresh scores when disk persistence fails', async () => {
+  const warnings = mock.method(logger, 'warn', () => logger);
+  const blockedDirectory = path.join(directory, 'blocked');
+  await writeFile(blockedDirectory, 'not a directory');
+  const blockedCache = new ImdbRatingCache(blockedDirectory);
+  const fetchRating = async () => ({ rating, releaseDate: '2020-01-01' });
+  assert.deepEqual(
+    await blockedCache.getOrFetch({
+      mediaType: 'movie',
+      tmdbId: 1,
+      fetchRating,
+    }),
+    rating
+  );
+  assert.equal(warnings.mock.callCount(), 2);
+});
+
+it('waits for pending writes before clearing and makes new lookups fetch again', async () => {
+  const cache = new ImdbRatingCache(directory);
+  const started = Promise.withResolvers<void>();
+  const release = Promise.withResolvers<void>();
+  const pending = cache.getOrFetch({
+    mediaType: 'movie',
+    tmdbId: 1,
+    fetchRating: async () => {
+      started.resolve();
+      await release.promise;
+
+      return { rating, releaseDate: '2020-01-01' };
+    },
+  });
+  await started.promise;
+
+  const clearing = cache.clear();
+  const newRating = { ...rating, criticsScore: 9 };
+  const afterClear = cache.getOrFetch({
+    mediaType: 'movie',
+    tmdbId: 1,
+    fetchRating: async () => ({ rating: newRating, releaseDate: '2020-01-01' }),
+  });
+  release.resolve();
+  await pending;
+  await clearing;
+
+  assert.deepEqual(await afterClear, newRating);
+  const restartedCache = new ImdbRatingCache(directory);
+  assert.deepEqual(
+    await restartedCache.getOrFetch({
+      mediaType: 'movie',
+      tmdbId: 1,
+      fetchRating: async () =>
+        assert.fail('Post-flush rating should be stored'),
+    }),
+    newRating
+  );
+});
