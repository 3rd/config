#!/usr/bin/env bash
IFS=$'\n\t'

if [[ "${BASH_SOURCE[0]}" = "$0" ]]; then
  if [ "$#" -ne 1 ]; then
    echo "screen2mp4 target.mp4"
    exit 0
  fi

  OUTPUT="${1%.mp4}.mp4"

  read -r -p "Record audio? [y/N] " audio
  case $audio in
    [Yy]*)
      audio=(-f pulse -ac 2 -i @DEFAULT_MONITOR@)
      ;;
    *)
      audio=()
      ;;
  esac

  if [ ${#audio[@]} -eq 0 ]; then
    read -r -p "Record microphone? [y/N] " mic
    case $mic in
      [Yy]*)
        audio=(-f pulse -ac 2 -i default)
        ;;
      *) ;;
    esac
  fi

  slop=$(slop -f "%x %y %w %h %g %i") || exit 1
  IFS=$' ' read -r X Y W H _ < <(echo """$slop")
  W=$((W + W % 2))
  H=$((H + H % 2))

  capture_status=0
  trap '' INT
  echo "Recording..."

  ffmpeg -loglevel "16" -f "x11grab" -framerate "60" -s "${W}x$H" -i ":0.0+$X,$Y" "${audio[@]}" -c:v libx264 -preset ultrafast -crf 0 -pix_fmt yuv420p -c:a flac "$OUTPUT".mkv || capture_status=$?
  trap - INT

  if [ "$capture_status" -ne 0 ] && [ "$capture_status" -ne 255 ]; then
    exit "$capture_status"
  fi

  echo "Compressing..."
  ffmpeg -i "$OUTPUT".mkv -c:v libx264 -preset slow -crf 18 -c:a aac -movflags +faststart "$OUTPUT" || exit $?
  rm "$OUTPUT".mkv
  while true; do
    read -r -p "Preview? [y/N] " preview
    case $preview in
      [Yy]*)
        mpv "$OUTPUT"
        break
        ;;
      *)
        break
        ;;
    esac
  done
fi
