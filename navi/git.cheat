% git

# Create a backdated commit from staged changes
GIT_COMMITTER_DATE="<days> days ago" \
  git commit --date="<days> days ago" --message="<message>"

# Force-push a branch without overwriting unseen remote work
git push --force-with-lease <remote> <branch>

# Add a Git submodule
git submodule add <repository> "<submodule_path>"

# Undo recent commits and keep their changes staged
git reset --soft HEAD~<count>

# Undo recent commits and keep their changes unstaged
git reset --mixed HEAD~<count>

# Delete recent commits and their changes permanently
git reset --hard HEAD~<count>

# Interactively rewrite recent commits
git rebase --interactive HEAD~<count>

# Find branches containing a commit
git branch --all --contains <commit>

# Delete a merged local branch
git branch --delete <local_branch>

# Delete a remote branch
git push <remote> --delete <remote_branch>

# Show reflog entries for recovering lost commits
git reflog --date=local

$ remote: git remote
$ branch: git branch --format='%(refname:short)'
$ local_branch: git branch --format='%(refname:short)'
$ remote_branch: git for-each-ref --format='%(refname:strip=3)' "refs/remotes/<remote>" | grep -v '^HEAD$'
$ commit: git log --all --format='%h%x09%s' --- --column 1 --delimiter '\t'
$ submodule_path: fd --type d --max-depth 3
$ days: printf '1\n2\n3\n7\n14\n30\n'
$ count: printf '1\n2\n3\n5\n10\n'
