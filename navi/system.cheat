% system

# Show the system boot-time summary
systemd-analyze time

# Rank system units by startup time
systemd-analyze blame

# Rank user units by startup time
systemd-analyze --user blame

# Show the system boot critical chain
systemd-analyze critical-chain

# Show the user-session critical chain
systemd-analyze --user critical-chain

# Render the system boot timeline to SVG
systemd-analyze plot > "<graph_file>"

# Analyze a service's security exposure
systemd-analyze security <unit>

# Verify a systemd unit file
systemd-analyze verify "<unit_file>"

$ unit: systemctl list-unit-files --type=service --no-legend | awk '{print $1}'
$ unit_file: fd --type f --extension service
$ graph_file: printf 'systemd-boot.svg\n'
