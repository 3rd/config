% nix

# List packages in the user profile
nix profile list

# Add a package to the user profile
nix profile add nixpkgs#<package>

# Upgrade every package in the user profile
nix profile upgrade --all

# Uninstall a package from the user profile
nix profile remove <profile_package>

# Explain why the current system depends on a store path
nix why-depends /run/current-system <store_path>

# Show recursive closure sizes for the current system
nix path-info --recursive --closure-size --human-readable /run/current-system

# Render the current system's store graph to SVG
nix-du --root /run/current-system/sw --min-size <min_size> --opt-level 2 \
  | dot -Tsvg > "<graph_file>"

# Verify every Nix store path
nix store verify --all

# Repair corrupted Nix store paths
sudo nix store verify --all --repair

# Delete unreachable Nix store paths
sudo nix store gc

$ profile_package: nix profile list | sed -n 's/^Name:[[:space:]]*//p'
$ store_path: nix path-info --recursive /run/current-system
$ min_size: printf '100MB\n250MB\n500MB\n1GB\n'
$ graph_file: printf 'nix-store.svg\n'
