% linux

# Show logs from the current boot
journalctl --boot --pager-end

# Follow logs from the current boot
journalctl --boot --follow

# Show kernel logs from the current boot
journalctl --boot --dmesg --pager-end

# Show warnings and errors from the current boot
journalctl --boot --priority=warning --pager-end

# Follow a system service's logs
journalctl --boot --follow --unit <unit>

# Follow a user service's logs
journalctl --user --follow --unit <user_unit>

# Query the default application for a MIME type
xdg-mime query default <mime_type>

# Disable IPv6 until reboot
sudo sysctl -w net.ipv6.conf.all.disable_ipv6=1 \
  && sudo sysctl -w net.ipv6.conf.default.disable_ipv6=1

# Enable IPv6 until reboot
sudo sysctl -w net.ipv6.conf.all.disable_ipv6=0 \
  && sudo sysctl -w net.ipv6.conf.default.disable_ipv6=0

# Inspect libinput events and keycodes
sudo libinput debug-events --show-keycodes

$ unit: systemctl list-unit-files --type=service --no-legend | awk '{print $1}'
$ user_unit: systemctl --user list-unit-files --type=service --no-legend | awk '{print $1}'
